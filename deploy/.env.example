# Non-secret settings: copy to /opt/nirengi/.env (0600 root) and fill in. Secrets go to /opt/nirengi/secrets/
# (docs/isletim.md §7), never here.

# Release to run; deploy.sh writes this line.
NIRENGI_VERSION=0.1.0
# GHCR owner of ghcr.io/<owner>/nirengi-api (lower case).
NIRENGI_IMAGE_OWNER=
# API host name, e.g. api.example.com (A record to this server). Also the only AllowedHosts entry.
NIRENGI_API_HOST=
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=
# Admin account e-mail (register with it, set up TOTP on first sign-in).
NIRENGI_ADMIN_EMAIL=

# Optional: Sentry DSN of the nirengi-api project (empty = off).
SENTRY_DSN=
# Optional: refuse mobile versions older than this (426), e.g. 1.2.0. Empty = off.
CLIENTS_MINIMUM_VERSION=

# Transactional mail relay (docs/isletim.md §9). Password: secrets/Smtp__Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Nirengi
